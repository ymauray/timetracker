<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>TimeTracker</AssemblyName>
    <!-- Pas de RuntimeIdentifier/SelfContained par defaut : dotnet build/test restent portables.
         Le binaire standalone se produit via dotnet publish avec -r et self-contained explicites (voir README). -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType>embedded</DebugType>
    <!-- Ecrase avec -p:Version=X.Y.Z lors d'une publication de release (voir .github/workflows/release.yml) -->
    <Version>0.0.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="QuestPDF" Version="2026.9.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Fonts\Roboto.ttf" />
  </ItemGroup>

  <!-- QuestPDF ships a bundled Lato font pack as a loose content file; nous embarquons notre
       propre police (Fonts/Roboto.ttf) donc ce fichier est inutile pour un binaire monolithique. -->
  <Target Name="RemoveUnusedQuestPdfFontPack" AfterTargets="Publish;Build">
    <ItemGroup>
      <_UnusedFontFile Include="$(OutDir)QuestPDF.Fonts.Lato.br" />
      <_UnusedFontFile Include="$(PublishDir)QuestPDF.Fonts.Lato.br" />
    </ItemGroup>
    <Delete Files="@(_UnusedFontFile)" Condition="Exists('%(_UnusedFontFile.Identity)')" />
  </Target>

</Project>
